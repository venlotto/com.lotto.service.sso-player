# Application Configuration
APP_NAME=com.lotto.service.sso-internal
APP_PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/auth"

# JWT Configuration
JWT_SECRET="replace-me"
JWT_EXPIRATION="15m"
JWT_ISSUER=https://auth.plus.bingo
JWT_AUDIENCE=plus.bingo

# Refresh Token Configuration
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ROTATION_ENABLED=true

# Cookie Configuration (SSO)
COOKIE_SECRET="replace-me-too"
SESSION_COOKIE_NAME=plus_session
COOKIE_DOMAIN=.plus.bingo
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/
ACCESS_TOKEN_COOKIE_NAME=

# CORS Configuration
ALLOWED_ORIGINS=https://plus.bingo,https://auth.plus.bingo,https://*.plus.bingo
CORS_FALLBACK_ORIGIN=

# Redirect Whitelist
REDIRECT_WHITELIST=https://plus.bingo/web.bingo-reports,https://plus.bingo/web.pos

# Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

