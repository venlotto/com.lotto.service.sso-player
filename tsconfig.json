{
  "extends": "./tsconfig.koperca.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    // Must accompany allowSyntheticDefaultImports. Without it, a default
    // import of a CommonJS package type-checks but emits `require(...).default`
    // — undefined at runtime. tsc, eslint and the unit tests all pass; the
    // service only fails when it boots. See src/main.ts.
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "resolveJsonModule": true
  }
}
